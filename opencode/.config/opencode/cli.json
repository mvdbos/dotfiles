{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "dracula"
  },
  "keybinds": {
    "app.exit": "ctrl+d,<leader>q",
    "model.cycle_favorite": "ctrl+m"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true
}
