{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "lsp": {
    "typescript": {
      "command": [
        "ts-lsp"
      ]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git filter-branch*": "ask",
      "git push --delete*": "ask",
      "git push --force*": "ask",
      "git push --force-with-lease*": "ask",
      "git push -f*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset --hard*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "/var/folders/*/*/T/**": "allow",
      "/private/var/folders/*/*/T/**": "allow",
      "~/.config/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/.cache/**": "allow",
      "~/.agents/**": "allow"
    }
  },
  "provider": {
    "deepseek": {
      "blacklist": [
        "deepseek-v4-flash",
        "deepseek-v4-flash-vision-exp",
        "deepseek-v4-pro"
      ],
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "description": "DeepSeek-V4.1-Flash: causal encoder-decoder, 8B active (16B output), native vision, replaces deepseek-v4-flash",
          "attachment": true,
          "reasoning": true,
          "reasoning_options": [
            {
              "type": "toggle"
            },
            {
              "type": "effort",
              "values": [
                "low",
                "high",
                "max"
              ]
            }
          ],
          "tool_call": true,
          "structured_output": true,
          "temperature": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "reasoning": 0.6,
            "cache_read": 0.003
          }
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1",
        "apiKey": "{env:OMLX_API_KEY}"
      },
      "models": {
        "Qwen3.5-0.8B-8bit": {
          "name": "Qwen3.5-0.8B-8bit",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 8192,
            "output": 8192
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "Qwen3.5-4B-oQ4e-mtp": {
          "name": "Qwen3.5-4B-oQ4e-mtp",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 114688,
            "output": 16384
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "Qwen3.6-35B-A3B-Uncensored-Heretic-MLX-6bit": {
          "name": "Qwen3.6-35B-A3B-Uncensored-Heretic-MLX-6bit",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "ds4": {
      "name": "ds4.c (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:DS4_API_KEY}"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash Next Q4 (ds4.c local)",
          "description": "Qwen3.8-Flash-Next Q4 via ds4-server: Metal, vision, MTP speculation",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "qwen3.8-flash-next-chat": {
          "name": "Qwen3.8 Flash Next Q4 Chat (ds4.c local)",
          "description": "Same Qwen3.8-Flash-Next Q4, thinking disabled",
          "attachment": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "disabled_providers": [],
  "model": "ds4/qwen3.8-flash-next",
  "agent": {
    "build": {
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "title": {
      "model": "omlx/Qwen3.5-0.8B-8bit"
    },
    "general": {
      "description": "Delegate substantial multi-step work here: code reviews, audits, independent research, and investigations that span many files or sources. Use when a task needs its own context and several steps. Do NOT use for simple lookups or single-file reads — keep those in the primary agent. The primary agent verifies and synthesizes the findings."
    },
    "explore": {
      "model": "omlx/Qwen3.5-4B-oQ4e-mtp",
      "prompt": "{file:./explore-controls/explore-prompt.txt}",
      "description": "Codebase explorer for discovery and evidence gathering. Use for broad or multi-file exploration: finding files by pattern (eg. \"src/components/**/*.tsx\"), searching for keywords, tracing code paths, or answering how-the-codebase-works questions (eg. \"how do API endpoints work?\"). Do NOT use for reviews, audits, or research; use general for those. Keep each task focused and bounded; split broad investigations into smaller tasks, since search budget and context are limited and findings may be partial.",
      "options": {
        "enable_thinking": false
      },
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "todowrite": "deny"
      }
    }
  }
}
