{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "azure-devops": {
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "{env:AZURE_DEVOPS_ORG}",
        "-d",
        "core",
        "work",
        "work-items",
        "repositories",
        "pipelines"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git filter-branch*": "ask",
      "git push --delete*": "ask",
      "git push --force*": "ask",
      "git push --force-with-lease*": "ask",
      "git push -f*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset --hard*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "~/.config/**": "allow",
      "~/.dotfiles/**": "allow"
    }
  },
  "provider": {
    "ollama": {
      "models": {
        "devstral-small-2": {
          "_launch": true,
          "name": "devstral-small-2"
        },
        "qwen3-coder:30b": {
          "_launch": true,
          "name": "qwen3-coder:30b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}